---
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import ShotThemeToggle from '../components/ShotThemeToggle.astro';
import FederationDiagram from '../components/FederationDiagram.astro';
import { url } from '../lib/url';
import '../styles/home.css';
import '../styles/features.css';
import '../styles/shots.css';

const xep = (n: string, label: string) => ({ href: `https://xmpp.org/extensions/xep-${n}.html`, label: `XEP-${n} ${label}` });
---

<Base title="Features: Chord" description="Chord looks like the app you already use, but nobody owns the network.">
	<div data-shots>
	<section class="stack page-head">
		<h1 class="display page-title">Chord looks like the app you already use, but <span class="hl">nobody owns the network.</span></h1>
		<p class="lede">
			Spaces on the left, channels next to them, messages in the middle. If you've touched a chat app in the last decade, you don't need
			a tour. The only new thing is the network underneath.
		</p>
		<ShotThemeToggle />
		<p class="status-note"><strong>Still cooking.</strong> This is what Chord's being built to do.</p>
	</section>

	<!-- The familiar layout -->
	<section class="familiar" id="layout">
		<div class="stack familiar-head">
			<span class="feature-kicker">The layout</span>
			<h2 class="display display-md">Your hands already know where everything is.</h2>
			<p class="lede">
				We didn't reinvent chat. We just moved it somewhere you actually keep your account. Your friends could switch on a Friday night and
				be arguing in the right channel by Saturday.
			</p>
		</div>
		<div class="familiar-body">
			<Shot platform="desktop" name="music" class="shot-cap is-wide" alt="Chord on the desktop: the space rail on the left, the basement space's channels next to it, and the music channel in the middle" />
			<ol class="layout-legend">
				<li>
					<div><strong>The rail</strong><span>Every space you're in, one icon each, down the left edge. Home sits at the top, for your DMs.</span></div>
				</li>
				<li>
					<div><strong>The channel list</strong><span>Channels for whatever space you're in. Bold means unread. Muted channels go quiet, like you asked.</span></div>
				</li>
				<li>
					<div><strong>The conversation</strong><span>Messages grouped by person, with replies, reactions, link previews, and a red line where you stopped paying attention.</span></div>
				</li>
				<li>
					<div><strong>The composer</strong><span>Type, hit Enter, done. Attach a file, drop in a GIF, pick an emoji. Nothing to learn. Sorry.</span></div>
				</li>
			</ol>
		</div>
		<p class="aside-line">We call them spaces, not servers. In Chord, a server's just the computer holding your account, and it can be yours.</p>
	</section>

	<!-- Spaces and channels -->
	<section class="feature" id="spaces">
		<div class="stack feature-copy">
			<span class="feature-kicker">Spaces and channels</span>
			<h2 class="display display-md">A space for every group you're in.</h2>
			<p class="lede">
				Your crew, your team, the group chat that's mostly memes. Each one gets a space with its own channels. Hop between them from the
				rail, and unread counts tell you where things went sideways while you were gone.
			</p>
			<p class="lede">
				Make your own, or search the public ones and barge in. Under the hood they're XMPP spaces, so other clients that speak them see the same groups.
			</p>
			<div class="xep">
				<a href={xep('0503', 'Server-side spaces').href}>{xep('0503', 'Server-side spaces').label}</a>
				<a href={xep('0045', 'Multi-User Chat').href}>{xep('0045', 'Multi-User Chat').label}</a>
			</div>
		</div>
		<div class="feature-visual">
			<Shot platform="desktop" name="join" class="shot-cap" alt="The Join a space dialog: a search box and a list of public spaces with their server, member count, and a Join button" />
		</div>
	</section>

	<!-- DMs and presence -->
	<section class="feature" id="dms">
		<div class="stack feature-copy">
			<span class="feature-kicker">DMs and presence</span>
			<h2 class="display display-md">See who's around before you ask.</h2>
			<p class="lede">
				DMs and group chats live on Home. Everyone's got a status, and every status gets a shape as well as a color, so you can read it
				even if red and green look the same to you. Tap a name for their card: status, roles, and a private note only you can see. Be honest in it.
			</p>
		</div>
		<div class="feature-visual">
			<div class="shot-pair">
				<Shot platform="desktop" name="profile" class="shot-cap is-phone" alt="A profile card: avatar, address, status, a Message button, roles, member since, a private note, and how many spaces you share" />
				<div class="vis" role="img" aria-label="Four people with different statuses">
					<div class="vis-label">DIRECT</div>
					<div class="vis-row"><span class="pres pres-online"></span><span class="grow">marco</span><span class="vis-sub">Available</span></div>
					<div class="vis-row"><span class="pres pres-away"></span><span class="grow">theo</span><span class="vis-sub">Away</span></div>
					<div class="vis-row"><span class="pres pres-dnd"></span><span class="grow">lena</span><span class="vis-sub">Do not disturb</span></div>
					<div class="vis-row"><span class="pres pres-offline"></span><span class="grow">rory</span><span class="vis-sub">Offline</span></div>
				</div>
			</div>
		</div>
	</section>

	<!-- History and devices -->
	<section class="feature" id="devices">
		<div class="stack feature-copy">
			<span class="feature-kicker">History on every device</span>
			<h2 class="display display-md">Pick up right where you left off.</h2>
			<p class="lede">
				Your server keeps your history. Desktop, phone, laptop: sign in on all three and they'll show the same conversation. No more "check
				your other device."
			</p>
			<div class="xep">
				<a href={xep('0313', 'Message Archive').href}>{xep('0313', 'Message Archive').label}</a>
				<a href={xep('0280', 'Carbons').href}>{xep('0280', 'Carbons').label}</a>
			</div>
		</div>
		<div class="feature-visual">
			<div class="shot-pair">
				<Shot platform="desktop" name="link-preview" class="shot-cap" alt="The music channel on the desktop" />
				<Shot platform="android" name="timeline" alt="The same channel on Android" />
			</div>
		</div>
	</section>

	<!-- Files -->
	<section class="feature" id="files">
		<div class="stack feature-copy">
			<span class="feature-kicker">Photos, links, and GIFs</span>
			<h2 class="display display-md">Just drop it in the channel.</h2>
			<p class="lede">
				Photos, screenshots, that PDF someone keeps asking for. Your server stores them, so the size limit's up to your server, not a
				subscription tier. Paste a link and Chord unfurls it. React with the emoji you mean, or lose the argument with a GIF.
			</p>
			<div class="xep"><a href={xep('0363', 'HTTP File Upload').href}>{xep('0363', 'HTTP File Upload').label}</a></div>
		</div>
		<div class="feature-visual">
			<div class="shot-pair">
				<Shot platform="desktop" name="pics" class="shot-cap is-phone" alt="A photo shared in a channel with a short message" />
				<Shot platform="desktop" name="emoji" class="shot-cap is-phone" alt="The emoji and GIF picker, with search, frequently used, and categories" />
			</div>
		</div>
	</section>

	<!-- Federation -->
	<section class="feature" id="federation">
		<div class="stack feature-copy">
			<span class="feature-kicker">One address, any server</span>
			<h2 class="display display-md">Talk to people on other servers. Yes, really.</h2>
			<p class="lede">
				Your address looks like an email: you@yourserver.org. People on other XMPP servers can join your spaces and DM you, and Chord shows
				their server next to their name so you always know where a message came from.
			</p>
			<div class="vis" role="img" aria-label="A message from a person on another server">
				<div class="vis-row"><span class="vis-avatar is-ink"></span><span class="grow"><strong>kai</strong> <span class="vis-server">@xmpp.example.net</span><br />is she touring this year</span></div>
			</div>
		</div>
		<div class="feature-visual">
			<FederationDiagram />
		</div>
	</section>

	<!-- Themes -->
	<section class="feature" id="themes">
		<div class="stack feature-copy">
			<span class="feature-kicker">Themes</span>
			<h2 class="display display-md">Dark, light, or yours.</h2>
			<p class="lede">
				Chord Dark and Chord Light are built in, with Catppuccin next to them. A theme is a CSS file: import one from a link, or write your
				own. Imported themes can't load anything from outside the app, so nobody's snooping on your screen.
			</p>
		</div>
		<div class="feature-visual">
			<Shot platform="desktop" name="appearance" class="shot-cap is-wide" alt="Appearance settings: a Dark, Light, or System mode switch and the built-in themes" />
		</div>
	</section>

	<!-- Comparison -->
	<section class="section" id="compare">
		<h2 class="display display-md">Same shape. Different rules.</h2>
		<div class="compare-wrap">
			<table class="compare">
				<thead>
					<tr><th scope="col"></th><th scope="col">Chord</th><th scope="col">The app you're thinking of</th></tr>
				</thead>
				<tbody>
					<tr><th scope="row">The layout</th><td class="is-chord">Spaces, channels, DMs</td><td>Also that</td></tr>
					<tr><th scope="row">Who runs the servers</th><td class="is-chord">You, a friend, or any XMPP host</td><td>One company</td></tr>
					<tr><th scope="row">Your account</th><td class="is-chord">An address on a server you pick</td><td>A row in their database</td></tr>
					<tr><th scope="row">Other apps</th><td class="is-chord">Any XMPP client can sign in to your account</td><td>Only theirs</td></tr>
					<tr><th scope="row">If the rules change</th><td class="is-chord">Pack up and move servers, or run your own</td><td>Click Agree, or leave your spaces behind</td></tr>
				</tbody>
			</table>
		</div>
	</section>

	<section class="cta">
		<h2 class="display display-md">Bring your crew.</h2>
		<div class="row">
			<a href={url('#get-chord')} class="btn btn-dark btn-lg">Download Chord</a>
			<a href={url('docs/find-a-server/')} class="btn btn-lg">Find a server</a>
		</div>
	</section>
	</div>
</Base>
