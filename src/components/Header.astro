---
import Mark from './Mark.astro';
import { url } from '../lib/url';

const links = [
	{ href: url('features/'), label: 'Features' },
	{ href: url('docs/find-a-server/'), label: 'Find a server' },
	{ href: url('docs/self-host/'), label: 'Self-host' },
	{ href: url('docs/'), label: 'Docs' },
	{ href: url('style-guide/'), label: 'Style guide' },
];
---

<header class="topbar">
	<div class="container topbar-inner">
		<a href={url()} class="wordmark" aria-label="Chord home">
			<Mark size={32} />
			<span class="wordmark-text">chord</span>
		</a>
		<nav class="topbar-links" aria-label="Main">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
		<div class="row">
			<!-- TODO: point these at the web client and the release page when they exist. -->
			<a href={url('docs/getting-started/')} class="btn">Open in browser</a>
			<a href={url('docs/getting-started/')} class="btn btn-primary">Download</a>
		</div>
	</div>
</header>
