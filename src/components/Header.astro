---
import Mark from './Mark.astro';
import { url } from '../lib/url';

const links = [
	{ href: url('features/'), label: 'Features' },
];
---

<header class="topbar">
	<div class="container topbar-inner">
		<a href={url()} class="wordmark" aria-label="Chord home">
			<Mark size={32} />
			<span class="wordmark-text">chord</span>
		</a>
		<nav class="topbar-links" aria-label="Main">
			{links.map((link) => <a href={link.href}>{link.label}</a>)}
		</nav>
		<div class="row">
			<a href={url('#get-chord')} class="btn btn-primary">Download</a>
		</div>
	</div>
</header>
