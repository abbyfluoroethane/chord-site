---
interface Props {
	size?: number;
	/** Hide the end dots. Use this below 24px. */
	simple?: boolean;
	class?: string;
}
const { size = 32, simple = false, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
	<circle class="mark-ring" cx="32" cy="32" r="22"></circle>
	<line class="mark-chord" x1="11.3" y1="39.5" x2="39.5" y2="11.3"></line>
	{
		!simple && (
			<>
				<circle class="mark-node" cx="11.3" cy="39.5" r="5" />
				<circle class="mark-node" cx="39.5" cy="11.3" r="5" />
			</>
		)
	}
</svg>
